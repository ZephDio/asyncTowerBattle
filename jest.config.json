{
  "rootDir": "src",
  "testEnvironment": "node",
  "testMatch": [
    "**/*.spec.ts"
  ],
  "collectCoverageFrom": [
    "<rootDir>/**/*.{ts,tsx}"
  ],
  "transform": {
    "^.+\\.(t|j)sx?$": [
      "@swc/jest",
      {
        "jsc": {
          "parser": {
            "syntax": "typescript",
            "decorators": true
          }
        }
      }
    ]
  },
  "transformIgnorePatterns": [
    "node_modules/(?!@ddd-ts/traits)/traits.ts"
  ]
}