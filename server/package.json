{
  "name": "@async-tower-battle/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "prisma generate && prisma migrate deploy && nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "format": "biome format src --write",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:integration": "DATABASE_URL=${TEST_DATABASE_URL:?set by the devenv shell} prisma migrate deploy && DATABASE_URL=$TEST_DATABASE_URL NODE_OPTIONS=--experimental-vm-modules jest --runInBand --testMatch '**/*.int-spec.ts'",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-express": "^12.5.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "google-auth-library": "^11.3.4",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@nestjs/testing": "^12.5.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "prisma": "7.10.0",
    "supertest": "^7.3.2"
  }
}
