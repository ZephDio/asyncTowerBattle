// Run `pnpm db:generate` after changing this file, and `pnpm db:migrate:dev --name <change>` to version the change.

generator client {
  provider     = "prisma-client"
  output       = "../src/database/generated/prisma"
  moduleFormat = "esm"
  // Imports between the generated files end in .js, so they still resolve once `nest build` compiles them to dist.
  importFileExtension = "js"
}

// The server gives every row its id with its IdProvider (src/shared), so no id column has a default.

// The URL comes from DATABASE_URL, see prisma.config.ts.
datasource db {
  provider = "postgresql"
}

// A board a player sent when asking for an opponent, with their performance at the time. It is an opponent board
// until a pull consumes it, then a legacy board. A round's boards are only consumed once it holds more than 50.
model PlayerBoard {
  id        String    @id @db.Uuid
  round     Int
  // The SerializedBoard as JSON.
  board     Json
  wins      Int
  losses    Int
  createdAt DateTime  @default(now()) @map("created_at")
  // When a pull consumed the board, null while it is still available.
  pulledAt  DateTime? @map("pulled_at")
  // The player who built the board, null for a guest's board and the bot boards. A player never pulls their own.
  playerId  String?   @map("player_id") @db.Uuid
  player    Player?   @relation(fields: [playerId], references: [id], onDelete: SetNull)
  // A board no player built, such as the seed boards. A pull only gives one when its round has no player board.
  bot       Boolean   @default(false)
  // The boards whose players pulled this one as their opponent, each sent in the same request, oldest first. Empty for
  // the boards pulled before the column held several.
  pulledBy  String[]  @default([]) @map("pulled_by") @db.Uuid

  @@index([round, pulledAt])
  @@index([playerId])
  @@map("player_board")
}

// The projection of how many available (not consumed) boards each round holds, which PrismaOpponentBoardStore keeps
// up to date along with the player_board rows.
model RoundBoardCount {
  round Int @id
  count Int

  @@map("round_board_count")
}

// A player with an account, who signs in with Google or with their email and password. Guests play without one.
model Player {
  id            String         @id @db.Uuid
  // The Google account's `sub`, stable across email changes. Null for a player who signs in with a password.
  googleId      String?        @unique @map("google_id")
  // The password's scrypt hash with its salt and parameters. Null for a player who signs in with Google.
  passwordHash  String?        @map("password_hash")
  // Lower case.
  email         String         @unique
  // Unique ignoring case, which the register use cases check: the index only refuses exact duplicates.
  name          String         @unique
  createdAt     DateTime       @default(now()) @map("created_at")
  refreshTokens RefreshToken[]
  boards        PlayerBoard[]

  @@map("player")
}

// A refresh token of a player's session, stored as its SHA-256 hash. It is used once: refreshing revokes it and
// issues the next one.
model RefreshToken {
  id        String    @id @db.Uuid
  playerId  String    @map("player_id") @db.Uuid
  player    Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  @@index([playerId])
  @@map("refresh_token")
}
